# Copie para .env e ajuste os valores. O arquivo .env real NÃO é versionado.

# Perfil Spring (dev|prod)
SPRING_PROFILES_ACTIVE=dev

# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=financebot
DB_USER=financebot
DB_PASSWORD=financebot-local

# Integracoes (nunca commite valores reais)
TELEGRAM_BOT_TOKEN=

# --- IA (provedor compativel com a API da OpenAI) ---
# Por padrao aponta para a OpenAI. Para usar o Groq (plano gratuito, sem cartao):
#   1. crie a chave em https://console.groq.com/keys
#   2. preencha AI_API_KEY e ajuste base URL e modelos como abaixo
#AI_BASE_URL=https://api.openai.com/v1
#AI_TRANSCRIPTION_MODEL=whisper-1
#AI_EXTRACTION_MODEL=gpt-4o-mini
#AI_BASE_URL=https://api.groq.com/openai/v1
#AI_TRANSCRIPTION_MODEL=whisper-large-v3-turbo
#AI_EXTRACTION_MODEL=openai/gpt-oss-20b
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_TRANSCRIPTION_MODEL=whisper-1
AI_EXTRACTION_MODEL=gpt-4o-mini
# Idioma fixo na transcrição (pt) ou vazio para detecção automática
AI_TRANSCRIPTION_LANGUAGE=

# Fuso horário de negócio
APP_TIMEZONE=America/Sao_Paulo
